# Copy to .env for local `docker compose up`. All three are auto-generated on
# Miget - they only need values here.

# Relay signing identity, exactly 64 hex chars: openssl rand -hex 32
# Events signed with it stop verifying if it changes, so keep it stable once a
# relay has data. An invalid value is a hard startup error, not a warning.
BUZZ_RELAY_PRIVATE_KEY=1111111111111111111111111111111111111111111111111111111111111111

# Signs the relay's own git hooks, 32+ chars: openssl rand -hex 32
BUZZ_GIT_HOOK_HMAC_SECRET=2222222222222222222222222222222222222222222222222222222222222222

# MinIO root password for the media bucket: openssl rand -hex 16
MINIO_ROOT_PASSWORD=local-dev-only-change-me

# Public URL. The relay is same-origin locally, so the defaults already fit and
# browser clients derive wss:// from the page location; on Miget these three are
# wired from the app's domain automatically.
# RELAY_URL=ws://localhost:5000
# BUZZ_MEDIA_BASE_URL=http://localhost:5000/media
# BUZZ_CORS_ORIGINS=http://localhost:5000

# Lock the relay down once you have an identity (see README).
# RELAY_OWNER_PUBKEY=<your 64-char hex Nostr pubkey>
# BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
# BUZZ_REQUIRE_AUTH_TOKEN=true

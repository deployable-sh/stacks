# Bootstrap admin, used to create the first admin account on an empty DB.
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=local-dev-only-change-me

# Public URL Keycloak should advertise, e.g. https://id.example.com
# Leave empty for local development. Set it in any deployment where the proxy
# in front does not overwrite the Host header: without it a spoofed Host
# changes the issuer Keycloak puts in tokens and password-reset emails.
KC_HOSTNAME=
